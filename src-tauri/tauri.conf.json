{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aster",
  "version": "0.1.0",
  "identifier": "dev.aster.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:client",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aster",
        "width": 1487,
        "height": 1058,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://localhost:* http://127.0.0.1:* https: ws: wss:"
    }
  },
  "bundle": {
    "active": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["aster"]
      }
    }
  }
}
